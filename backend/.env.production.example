APP_NAME=Wosool
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.wosool.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# For a NEW Hostinger MySQL database only. Preserve the engine and credentials
# of any existing deployment. Fill these values in the private backend/.env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.wosool.org
FRONTEND_URL=https://wosool.org
SANCTUM_STATEFUL_DOMAINS=wosool.org,www.wosool.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Use the SMTP provider's actual host, port, credentials, and verified sender.
# Use smtps with port 465 if required by the provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@wosool.org"
MAIL_FROM_NAME="${APP_NAME}"

GATEWAY_PRIVACY_READY=false
GATEWAY_EMAIL_UPDATES=false
