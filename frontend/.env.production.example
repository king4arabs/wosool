# Public build configuration only. Add these values to Hostinger's environment
# settings, or copy this file to .env.production for a local release build.
NEXT_PUBLIC_SITE_URL=https://wosool.org
NEXT_PUBLIC_API_URL=https://api.wosool.org
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=false

# Optional public ownership verification tokens (set before building)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=
YANDEX_SITE_VERIFICATION=
